# A configuração da forma de produção (`compose.producao.yml`).
#
# Copia para `.env.producao` na máquina e preenche. ⚠️ **O `.env.producao` não é
# versionado** — leva a password da base.
#
#   cp .env.producao.example .env.producao

# --- A imagem ---------------------------------------------------------------

# A tag a correr. Construída na máquina (`docker build -t simulador-v2:local .`)
# ou puxada de um registo.
#
# ⚠️ **Uma tag fixa e não `latest`.** Com `latest` não há como saber o que está a
# correr nem como voltar atrás — e voltar atrás é o que se quer poder fazer às
# duas da manhã.
IMAGEM=simulador-v2:local

# --- O domínio --------------------------------------------------------------

# O domínio que o Caddy serve, e para o qual pede o certificado.
#
# ⚠️ **Tem de já apontar para o IP desta máquina antes de subir.** O Caddy pede o
# certificado à Let's Encrypt no arranque, por HTTP-01: se o DNS ainda não
# resolver para cá, o desafio falha, e há limite de tentativas por domínio por
# semana.
DOMINIO=

# Para onde a Let's Encrypt avisa que um certificado está a expirar.
EMAIL_ACME=

# --- A base -----------------------------------------------------------------

# ⚠️ **A base não publica portas** — só existe na rede do compose. Estas
# credenciais não atravessam a internet, e mesmo assim a password gera-se:
#
#   openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
PG_UTILIZADOR=simulador
PG_PASSWORD=
PG_BASE=simulador

# --- A fronteira HTTP -------------------------------------------------------

# As origens que podem chamar `/api/v1/*` de dentro de um browser, separadas por
# vírgulas. Vazio DESLIGA o CORS — e desligado quer dizer «só a mesma origem»,
# não «toda a gente». Um `*` é recusado ao arranque.
ORIGENS_PERMITIDAS=

# ⚠️ **POR MEDIR NO PRIMEIRO DEPLOY, e não se adivinha.** É o endereço de onde o
# Caddy fala com o serviço, dentro da rede do compose. O `docs/DEPLOY.md` tem o
# comando que o lê da linha do diário.
#
# Vazio, o tecto por IP conta pelo endereço da LIGAÇÃO — que aqui é o Caddy,
# igual para toda a gente: o tecto do site inteiro passa a ser o de um
# utilizador, e o primeiro visitante tranca os restantes. **É o bug de produção
# do v1.**
#
# O erro contrário é pior: uma rede larga de mais deixa quem estiver nela
# escolher o seu IP num cabeçalho e contornar o tecto de vez. Escreve-se a rede
# EXACTA — e até estar medida fica vazio, porque um tecto apertado de mais é
# visível e um contornável não é.
PROXIES_DE_CONFIANCA=

# --- Os números que se podem afinar ----------------------------------------

# Pedidos nossos em voo contra o MESMO banco. Vazio vale 2 — o apertado que está
# medido sem falhas. Subir isto não se faz procurando onde o banco parte.
VAGAS_POR_BANCO=

# Validade da cache das respostas. Vazio vale 5m.
#
# ⚠️ **5m é valor de partida e NÃO uma medição.** Mede-se com uma vigia de horas
# — perguntar o mesmo ao mesmo banco e ver quando muda —, e o que decide é a
# PRIMEIRA mudança, não a média. `0` desliga a cache.
CACHE_VALIDADE=
